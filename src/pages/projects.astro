---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="page">
		<section class="content">
			<p class="label">projects</p>

			<h1>Things I'm making.</h1>

			<p class="intro">
				Wise guy once said you can poke at the world and something will pop out. I'm somewhat of a professional poker and prodder of things, I'm doing an assemblage of my various escapades here
			</p>

			<div class="project-list">
				<article>
					<p class="status">ongoing</p>
					<h2>Personal Website</h2>
					<p>
						A little corner of the internet for my writing, projects,
						obsessions, and assorted wandering. This is one where you're reading this basically. Welcome!
					</p>
				</article>

				<article>
					<p class="status">idea</p>
					<h2>More things to come</h2>
					<p>
						I'm interested in making things that sit somewhere between
						technology, art, culture, curiosity, and play.
					</p>
				</article>
			</div>
		</section>
	</main>
</Layout>

<style>
	:global(body) {
		margin: 0;
		font-family: 'Philosopher', sans-serif;
		color: #eee5f5;
		background:
			radial-gradient(circle at 15% 20%, #5b3b78 0%, transparent 38%),
			radial-gradient(circle at 85% 15%, #164f61 0%, transparent 35%),
			radial-gradient(circle at 75% 75%, #285b45 0%, transparent 38%),
			radial-gradient(circle at 25% 85%, #7b315f 0%, transparent 35%),
			#16121f;
		min-height: 100vh;
	}

	.page {
		min-height: 100vh;
	}

	.content {
		width: min(680px, 80vw);
		margin: 0 auto;
		padding: 18vh 0 12vh;
	}

	.label {
		font-size: 28px;
		margin: 0 0 24px;
		opacity: 0.7;
	}

	h1 {
		font-size: clamp(52px, 5vw, 68px);
		line-height: 1.05;
		font-weight: 400;
		margin: 0 0 28px;
	}

	.intro {
		font-size: 30px;
		line-height: 1.5;
		max-width: 600px;
		margin: 0 0 80px;
		opacity: 0.75;
	}

	.project-list {
		border-top: 1px solid rgba(238, 229, 245, 0.3);
	}

	article {
		padding: 36px 0;
		border-bottom: 1px solid rgba(238, 229, 245, 0.3);
	}

	.status {
		font-size: 28px;
		opacity: 0.5;
		margin: 0 0 12px;
	}

	h2 {
		font-size: 36px;
		font-weight: 400;
		margin: 0 0 12px;
	}

	article p:last-child {
		font-size: 28px;
		line-height: 1.5;
		opacity: 0.7;
		margin: 0;
	}
</style>
