---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="page">

		<nav>
			<a href="/">Sriraksha</a>
			<div class="nav-links">
				<a href="/about">About</a>
				<a href="/writing">Writing</a>
				<a href="/projects">Projects</a>
				<a href="/now">Now</a>
			</div>
		</nav>

		<section class="content">
			<p class="eyebrow">about</p>

			<h1>Who am I?</h1>

			<div class="body">
				<p>
					I'm Sriraksha, but most people call me Raksha.
				</p>

				<p>
					I'm a curiosity collector in the realm of ideas. I'm a trivia connoisseur, troubadour and aspiring patron of the arts. I'm learning to live from a more authentic place and this corner of the internet
					will serve as an archive of my spelunking.
				</p>

				<p>
					I work with cameras, code, and machines by day, and spend
					the rest of my time following whatever catches my curiosity.
					I like making things, writing things, taking pictures,
					watching films, cooking, wandering around, and learning
					things I don't technically need to know.
				</p>

				<p>
					This website is an extension of my wandering mind, thank you for visiting!
				</p>
			</div>
		</section>

	</main>
</Layout>

<style>
	:global(body) {
		margin: 0;
		font-family: 'Philosopher', sans-serif;
		color: #eee5f5;
		background:
			radial-gradient(circle at 15% 20%, #5b3b78 0%, transparent 38%),
			radial-gradient(circle at 85% 15%, #164f61 0%, transparent 35%),
			radial-gradient(circle at 75% 75%, #285b45 0%, transparent 38%),
			radial-gradient(circle at 25% 85%, #7b315f 0%, transparent 35%),
			#16121f;
		min-height: 100vh;
	}

	.page {
		min-height: 100vh;
		padding: 32px 8%;
		box-sizing: border-box;
	}

	nav {
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-size: 18px;
	}

	nav a {
		color: inherit;
		text-decoration: none;
	}

	nav a:hover {
		opacity: 0.5;
	}

	.nav-links {
		display: flex;
		gap: 32px;
	}

	.content {
		max-width: 680px;
		margin: 16vh auto 0;
	}

	.eyebrow {
		font-size: 22px;
		opacity: 0.7;
		margin-bottom: 24px;
	}

	h1 {
		font-size: clamp(52px, 5vw, 64px);
		font-weight: 400;
		line-height: 1.05;
		margin: 0 0 50px;
	}

	.body {
		font-size: 30px;
		line-height: 1.7;
	}

	.body p {
		margin: 0 0 30px;
	}
</style>
