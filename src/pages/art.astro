---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="page">
		<section class="content">
			<p class="label">art i love</p>

			<h1>A running list.</h1>

			<p class="intro">
				Books, films, music, papers, tweets, images, ideas, and anything else
				that catches my fancy.
			</p>

			<div class="love-list">
				<section>
					<h2>Books</h2>
				</section>

				<section>
					<h2>Films</h2>
				</section>

				<section>
					<h2>Music</h2>
				</section>

				<section>
					<h2>Writing &amp; ideas</h2>
				</section>

				<section>
					<h2>Scientific papers</h2>
				</section>

				<section>
					<h2>Internet ephemera</h2>
				</section>

				<section>
					<h2>Other things</h2>
				</section>
			</div>
		</section>
	</main>
</Layout>

<style>
	:global(body) {
		margin: 0;
		font-family: 'Philosopher', sans-serif;
		color: #eee5f5;
		background:
			radial-gradient(circle at 15% 20%, #5b3b78 0%, transparent 38%),
			radial-gradient(circle at 85% 15%, #164f61 0%, transparent 35%),
			radial-gradient(circle at 75% 75%, #285b45 0%, transparent 38%),
			radial-gradient(circle at 25% 85%, #7b315f 0%, transparent 35%),
			#16121f;
		min-height: 100vh;
	}

	.page {
		min-height: 100vh;
	}

	.content {
		width: min(680px, 80vw);
		margin: 0 auto;
		padding: 18vh 0 12vh;
	}

	.label {
		font-size: 22px;
		margin: 0 0 24px;
		opacity: 0.7;
	}

	h1 {
		font-size: clamp(42px, 5vw, 68px);
		line-height: 1.05;
		font-weight: 400;
		margin: 0 0 28px;
	}

	.intro {
		font-size: 21px;
		line-height: 1.5;
		max-width: 600px;
		margin: 0 0 80px;
		opacity: 0.75;
	}

	.love-list {
		border-top: 1px solid rgba(238, 229, 245, 0.3);
	}

	.love-list section {
		padding: 36px 0;
		border-bottom: 1px solid rgba(238, 229, 245, 0.3);
	}

	h2 {
		font-size: 30px;
		font-weight: 400;
		margin: 0;
	}
</style>
